# Retrieval/expansion and rule analysis stay local; final answers use an LLM.
DMS_STATE_RESOLVER=rules
DMS_LLM_PROVIDER=deepseek
DMS_LLM_MODEL=deepseek-flash
DMS_ANSWER_PROVIDER=deepseek
DMS_ANSWER_MODEL=deepseek-flash
DMS_ANSWER_MAX_TOKENS=256
# 可使用此环境变量；macOS 本机也支持从项目专用 Keychain 条目读取。
DEEPSEEK_API_KEY=replace-with-your-key

# GLM final answers: change DMS_ANSWER_PROVIDER=glm and
# DMS_ANSWER_MODEL=glm-4.7-flash above, then fill in this key.
# The standard BigModel endpoint is used, not the Coding Plan endpoint.
# GLM_API_KEY=replace-with-your-key
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# ZAI_API_KEY is also accepted when GLM_API_KEY is absent.
