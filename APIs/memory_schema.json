{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sample_id": {
      "type": "string"
    },
    "memories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "memory_id": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "state",
              "event",
              "goal",
              "preference",
              "requirement"
            ]
          },
          "content": {
            "type": "string"
          },
          "attribute": {
            "type": [
              "string",
              "null"
            ]
          },
          "value": {
            "type": [
              "string",
              "null"
            ]
          },
          "time": {
            "type": "object",
            "properties": {
              "session_id": {
                "type": "string"
              },
              "date_time": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "effective_at": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Date when the event or state takes effect, in YYYY-MM-DD format."
              }
            },
            "required": [
              "session_id"
            ],
            "additionalProperties": false
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "session_id": {
                  "type": "string"
                },
                "dia_id": {
                  "type": "string"
                },
                "quote": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "session_id",
                "dia_id"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "memory_id",
          "subject",
          "type",
          "content",
          "time",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "sample_id",
    "memories"
  ],
  "additionalProperties": false
}
