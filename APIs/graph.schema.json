{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "graph.schema.json",
  "title": "Graph Memory 契约",
  "$defs": {
    "GraphNode": {
      "type": "object",
      "properties": {
        "node_id": {"type": "string"},
        "node_type": {
          "enum": ["memory", "subject", "slot", "value", "session", "turn"]
        },
        "label": {"type": "string"},
        "memory_id": {"type": ["string", "null"], "default": null}
      },
      "required": ["node_id", "node_type", "label"],
      "additionalProperties": false
    },
    "GraphEdge": {
      "type": "object",
      "properties": {
        "source": {"type": "string"},
        "target": {"type": "string"},
        "relation": {
          "enum": [
            "ABOUT", "IN_SLOT", "HAS_VALUE", "OBSERVED_IN", "SUPPORTED_BY",
            "NEXT_STATE", "NEXT_TURN"
          ]
        },
        "weight": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "required": ["source", "target", "relation", "weight"],
      "additionalProperties": false
    },
    "GraphPath": {
      "type": "object",
      "properties": {
        "memory_id": {"type": "string"},
        "hops": {"type": "integer", "minimum": 1, "maximum": 4},
        "node_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "relations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "ABOUT", "IN_SLOT", "HAS_VALUE", "OBSERVED_IN", "SUPPORTED_BY",
              "NEXT_STATE", "NEXT_TURN"
            ]
          }
        }
      },
      "required": ["memory_id", "hops", "node_ids", "relations"],
      "additionalProperties": false
    },
    "GraphTrace": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "max_hops": {"type": "integer", "minimum": 1, "maximum": 4},
        "seed_memory_ids": {"type": "array", "items": {"type": "string"}},
        "added_memory_ids": {"type": "array", "items": {"type": "string"}},
        "eligible_memory_count": {"type": "integer", "minimum": 0, "default": 0},
        "visited_node_count": {"type": "integer", "minimum": 0, "default": 0},
        "truncated": {"type": "boolean", "default": false},
        "stop_reason": {
          "enum": ["disabled", "no_seed", "no_new_memory", "expanded", "candidate_limit"]
        },
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/GraphNode"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/GraphEdge"}},
        "paths": {"type": "array", "items": {"$ref": "#/$defs/GraphPath"}}
      },
      "required": ["enabled", "max_hops", "stop_reason"],
      "additionalProperties": false
    },
    "GraphDocument": {
      "type": "object",
      "properties": {
        "sample_id": {"type": "string"},
        "memory_count": {"type": "integer", "minimum": 0},
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/GraphNode"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/GraphEdge"}}
      },
      "required": ["sample_id", "memory_count", "nodes", "edges"],
      "additionalProperties": false
    }
  }
}
